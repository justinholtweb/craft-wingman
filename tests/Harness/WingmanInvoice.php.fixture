<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\SoftDeletes;

/** Wingman harness fixture: soft deletes, casts, a hidden token, a non-default label column. */
class WingmanInvoice extends Model
{
    use SoftDeletes;

    protected $table = 'wingman_invoices';

    protected $fillable = ['number', 'amount', 'paid', 'issued_on', 'token'];

    protected $hidden = ['token'];

    protected function casts(): array
    {
        return ['amount' => 'integer', 'paid' => 'boolean', 'issued_on' => 'date'];
    }
}
